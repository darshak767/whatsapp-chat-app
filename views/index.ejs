<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Whatsapp App</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <h1>Whatsapp App</h1>
  <form method="get" action="/chats/new" class="create-chat-form">
    <button type="submit">Create New Chat</button>
  </form>

  <% for(let chat of chats) { %>
    <div class="chatbox">
      <p>From : <%= chat.from %>
      </p>
      <p class="message">Message : <%= chat.message %>
      </p>
      <form method="get" action="/chats/<%= chat.id %>/edit">
        <button type="submit">Edit Post</button>
      </form>
      <p>Recieved By : <%= chat.to %>
      </p>
      <p>Time : <%= (chat.created_at.toString()).split(" ")[4] %></p>
      <p>Date : <%= (chat.created_at.toString()).split(" ").slice(0, 4).join(" ") %></p>
      <form method="post" action="/chats/<%= chat.id %>?_method=DELETE">
          <button type="submit">Delete Post</button>
          </form>
    </div>
    <% } %>

</body>

</html>